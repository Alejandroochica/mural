# Local development only. Supply real secrets through the deployment environment.
DATABASE_URL=postgresql://mural:local-development-only@localhost:5432/mural
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Native Apple revocation requires a read-only .p8 secret file and developer credentials.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Keep off for public deployments. This is a restricted voice-only engineering experiment.
HOSTED_VOICE_EXPERIMENTAL=false
HOSTED_VOICE_ACCOUNT_ALLOWLIST=
HOSTED_VOICE_LIFETIME_CAP_NANO=0
OPENAI_API_KEY=
# Only Stripe test keys are accepted in this foundation. Real purchases are blocked.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Server-side Stripe Price IDs; the client never supplies a price or credit amount.
STRIPE_TEST_PRICE_10_USD=
STRIPE_TEST_PRICE_25_USD=
# Match the exact fee-inclusive sandbox Stripe Prices you create. No default fee is invented.
STRIPE_TEST_PAYMENT_FEE_10_MINOR=
STRIPE_TEST_PAYMENT_FEE_25_MINOR=
